<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_dark">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Informative Tip Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_card_rounded"
            android:orientation="vertical"
            android:padding="14dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="📁"
                    android:textSize="22sp" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Large Files (> 50 MB)"
                    android:textColor="@color/white"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:layout_marginStart="8dp" />

                <TextView
                    android:id="@+id/tvLargeCountBadge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_pill_badge"
                    android:text="0 Files"
                    android:textColor="@color/status_blue"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"
                    android:paddingTop="4dp"
                    android:paddingBottom="4dp" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvLargeFilesDescription"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Files >50MB can be uploaded automatically through your Local Docker Bot API, or shared via official Telegram App."
                android:textColor="@color/white_70"
                android:textSize="12sp"
                android:lineSpacingExtra="2dp"
                android:layout_marginTop="8dp" />

            <!-- Local Docker Live Status Banner -->
            <TextView
                android:id="@+id/tvLocalDockerStatusInLarge"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="💻 Local Docker Server: Checking..."
                android:textColor="@color/primary_light"
                android:textSize="12sp"
                android:textStyle="bold"
                android:layout_marginTop="6dp" />

            <!-- Select All Checkbox -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="10dp">

                <CheckBox
                    android:id="@+id/cbSelectAll"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Select All Remaining Files"
                    android:textColor="@color/white"
                    android:textSize="13sp"
                    android:buttonTint="@color/primary" />

                <View
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1" />

                <TextView
                    android:id="@+id/tvSelectedStats"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0 selected"
                    android:textColor="@color/white_70"
                    android:textSize="12sp" />
            </LinearLayout>

        </LinearLayout>

        <!-- Filter Chips: Pending (বাকিগুলো) / All Large / Uploaded -->
        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:scrollbars="none"
            android:layout_marginTop="8dp">

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/chipGroupLargeFilter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:singleSelection="true">

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipLargePending"
                    style="@style/Widget.Material3.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checked="true"
                    android:text="⏳ Pending (বাকিগুলো)"
                    android:textColor="@color/white"
                    app:chipBackgroundColor="@color/surface_dark" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipLargeAll"
                    style="@style/Widget.Material3.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="📁 All Large"
                    android:textColor="@color/white"
                    app:chipBackgroundColor="@color/surface_dark" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipLargeUploaded"
                    style="@style/Widget.Material3.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="⚡ Uploaded (সম্পন্ন)"
                    android:textColor="@color/white"
                    app:chipBackgroundColor="@color/surface_dark" />

            </com.google.android.material.chip.ChipGroup>
        </HorizontalScrollView>

        <!-- Empty State for Large Files -->
        <LinearLayout
            android:id="@+id/layoutEmptyLarge"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="32dp"
            android:visibility="gone">

            <ImageView
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:src="@drawable/ic_nav_large"
                app:tint="@color/status_green"
                android:alpha="0.8" />

            <TextView
                android:id="@+id/tvEmptyLargeTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="No Pending Large Files! 🎉"
                android:textColor="@color/white"
                android:textSize="16sp"
                android:textStyle="bold"
                android:layout_marginTop="12dp" />

            <TextView
                android:id="@+id/tvEmptyLargeSubtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="All large files are either backed up or none found over 50MB."
                android:textColor="@color/white_70"
                android:textSize="12sp"
                android:gravity="center"
                android:layout_marginTop="4dp" />
        </LinearLayout>

        <!-- RecyclerView for Large Files -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvLargeFiles"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginTop="8dp"
            android:clipToPadding="false"
            android:paddingBottom="120dp" />

    </LinearLayout>

    <!-- Bottom Action Buttons Container -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingBottom="16dp"
        android:background="@color/bg_dark">

        <!-- Button 1: Upload via Local Docker Server -->
        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnUploadViaLocalDocker"
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:background="@drawable/bg_button_gradient"
            android:text="💻 Upload via Local Docker API"
            android:textAllCaps="false"
            android:textColor="@color/white"
            android:textSize="14sp"
            android:textStyle="bold"
            android:visibility="gone"
            android:layout_marginBottom="8dp" />

        <!-- Button 2: Share to Telegram App -->
        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnShareToTelegram"
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:background="@drawable/bg_button_secondary"
            android:text="🚀 Share to Telegram App"
            android:textAllCaps="false"
            android:textColor="@color/white"
            android:textSize="14sp"
            android:textStyle="bold" />

    </LinearLayout>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
