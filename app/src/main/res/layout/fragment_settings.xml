<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_dark"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Title -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Settings &amp; Configuration"
            android:textColor="@color/white"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Configure Telegram Bot, network limits &amp; native engine"
            android:textColor="@color/white_70"
            android:textSize="12sp"
            android:layout_marginTop="2dp"
            android:layout_marginBottom="16dp" />

        <!-- 1. Telegram Bot Token Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_card_rounded"
            android:orientation="vertical"
            android:padding="16dp"
            android:layout_marginBottom="12dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Telegram Bot Token"
                android:textColor="@color/white"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Create a bot with @BotFather and paste the HTTP API token here"
                android:textColor="@color/white_70"
                android:textSize="12sp"
                android:layout_marginTop="2dp" />

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilBotToken"
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                app:boxStrokeColor="@color/primary"
                app:hintTextColor="@color/primary">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etBotToken"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="e.g. 7123456789:AAHkL8-..."
                    android:inputType="textPassword"
                    android:textColor="@color/white"
                    android:textSize="14sp" />
            </com.google.android.material.textfield.TextInputLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="10dp">

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btnTestBot"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:background="@drawable/bg_button_secondary"
                    android:text="🔍 Test Bot"
                    android:textAllCaps="false"
                    android:textColor="@color/white"
                    android:textSize="13sp"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp" />

                <TextView
                    android:id="@+id/tvBotTestResult"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="10dp"
                    android:textColor="@color/status_green"
                    android:textSize="12sp" />
            </LinearLayout>

        </LinearLayout>

        <!-- 2. Telegram Channel ID Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_card_rounded"
            android:orientation="vertical"
            android:padding="16dp"
            android:layout_marginBottom="12dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Telegram Channel ID / Chat ID"
                android:textColor="@color/white"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="e.g. -1001234567890 or @your_channel (Add bot as Channel Admin!)"
                android:textColor="@color/white_70"
                android:textSize="12sp"
                android:layout_marginTop="2dp" />

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilChannelId"
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                app:boxStrokeColor="@color/primary"
                app:hintTextColor="@color/primary">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etChannelId"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="e.g. -1001928374650"
                    android:inputType="text"
                    android:textColor="@color/white"
                    android:textSize="14sp" />
            </com.google.android.material.textfield.TextInputLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="10dp">

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btnTestChannel"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:background="@drawable/bg_button_secondary"
                    android:text="🔍 Test Channel"
                    android:textAllCaps="false"
                    android:textColor="@color/white"
                    android:textSize="13sp"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp" />

                <TextView
                    android:id="@+id/tvChannelTestResult"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="10dp"
                    android:textColor="@color/status_green"
                    android:textSize="12sp" />
            </LinearLayout>

        </LinearLayout>

        <!-- Save Credentials Button -->
        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnSaveCredentials"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="@drawable/bg_button_gradient"
            android:text="💾 Save Telegram Settings"
            android:textAllCaps="false"
            android:textColor="@color/white"
            android:textSize="15sp"
            android:textStyle="bold"
            android:layout_marginBottom="16dp" />

        <!-- 3. Network Preference Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_card_rounded"
            android:orientation="vertical"
            android:padding="16dp"
            android:layout_marginBottom="12dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Network Allowed for Upload"
                android:textColor="@color/white"
                android:textSize="15sp"
                android:textStyle="bold" />

            <RadioGroup
                android:id="@+id/rgNetworkPref"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp">

                <RadioButton
                    android:id="@+id/rbNetworkBoth"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🌐 Both (Wi-Fi or Mobile Data)"
                    android:textColor="@color/white"
                    android:buttonTint="@color/primary" />

                <RadioButton
                    android:id="@+id/rbNetworkWifi"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="📶 Wi-Fi Only (Saves Mobile Data)"
                    android:textColor="@color/white"
                    android:buttonTint="@color/primary" />

                <RadioButton
                    android:id="@+id/rbNetworkMobile"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="📱 Mobile Data Only"
                    android:textColor="@color/white"
                    android:buttonTint="@color/primary" />

            </RadioGroup>
        </LinearLayout>

        <!-- 4. Concurrency Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_card_rounded"
            android:orientation="vertical"
            android:padding="16dp"
            android:layout_marginBottom="12dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Simultaneous Upload Streams"
                android:textColor="@color/white"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvConcurrencyDesc"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="2 files uploading at the same time"
                android:textColor="@color/white_70"
                android:textSize="12sp"
                android:layout_marginTop="2dp" />

            <com.google.android.material.slider.Slider
                android:id="@+id/sliderConcurrency"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:value="2.0"
                android:valueFrom="1.0"
                android:valueTo="4.0"
                android:stepSize="1.0"
                app:thumbColor="@color/primary"
                app:trackColorActive="@color/primary"
                app:trackColorInactive="@color/surface_dark" />

        </LinearLayout>

        <!-- 5. Native C Core Status Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_card_rounded"
            android:orientation="vertical"
            android:padding="16dp"
            android:layout_marginBottom="12dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="⚡"
                    android:textSize="18sp" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Native C Engine Status"
                    android:textColor="@color/white"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:layout_marginStart="8dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_pill_badge"
                    android:text="Native C"
                    android:textColor="@color/status_green"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp"
                    android:paddingTop="3dp"
                    android:paddingBottom="3dp" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvNativeStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Native C Core Active"
                android:textColor="@color/white_70"
                android:textSize="12sp"
                android:layout_marginTop="6dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Provides zero-overhead checksums, high-speed buffer chunking &amp; optimal memory streaming."
                android:textColor="@color/white_40"
                android:textSize="11sp"
                android:layout_marginTop="2dp" />

        </LinearLayout>

        <!-- 6. Battery Optimization Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_card_rounded"
            android:orientation="vertical"
            android:padding="16dp"
            android:layout_marginBottom="12dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Background Persistence"
                android:textColor="@color/white"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Disable Android battery restrictions to ensure uploads continue even when the app is swiped away from recent apps."
                android:textColor="@color/white_70"
                android:textSize="12sp"
                android:layout_marginTop="2dp" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnIgnoreBattery"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:background="@drawable/bg_button_secondary"
                android:text="🔓 Disable Battery Restrictions"
                android:textAllCaps="false"
                android:textColor="@color/white"
                android:textSize="13sp"
                android:layout_marginTop="10dp" />

        </LinearLayout>

        <!-- 7. Reset History Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_card_rounded"
            android:orientation="vertical"
            android:padding="16dp"
            android:layout_marginBottom="24dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Database &amp; History"
                android:textColor="@color/white"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvTotalUploadedHistory"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Total sent files recorded: 0"
                android:textColor="@color/white_70"
                android:textSize="12sp"
                android:layout_marginTop="2dp" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnResetHistory"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:background="@drawable/bg_button_secondary"
                android:text="🗑 Reset Uploaded History"
                android:textAllCaps="false"
                android:textColor="@color/status_red"
                android:textSize="13sp"
                android:layout_marginTop="10dp" />

        </LinearLayout>

    </LinearLayout>
</androidx.core.widget.NestedScrollView>

